include LICENSE README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md CHANGELOG.md THIRD_PARTY.md .gitignore .gitattributes
recursive-include .github *.yml *.md
recursive-include docs *.md
recursive-include examples *.json *.md
recursive-include tests *.py
recursive-include tools *.py
recursive-include bridge *.py *.md *.json *.yml *.yaml *.toml *.ndjson *.lean LICENSE lean-toolchain .gitignore
recursive-include corpus *.py *.md *.json *.yml *.yaml *.toml *.ndjson *.lean LICENSE lean-toolchain .gitignore
global-exclude __pycache__ *.py[cod] *.olean *.ilean
prune bridge/lean/.lake
prune bridge/openai/.lake
prune corpus/openai/lean/.lake
